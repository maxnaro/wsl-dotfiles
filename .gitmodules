[submodule "nvim/.config/nvim"]
	path = nvim/.config/nvim
	url = https://github.com/maxnaro/nvim-config.git
[submodule "modules/theme"]
	path = modules/theme
	url = https://github.com/maxnaro/dotfiles-theme.git
[submodule "modules/shell"]
	path = modules/shell
	url = https://github.com/maxnaro/dotfiles-shell.git
[submodule "shared-tmux"]
	path = tmux/.config/tmux
	url = https://github.com/maxnaro/dotfiles-tmux.git
