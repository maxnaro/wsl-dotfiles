#!/usr/bin/env python3
"""Apply the shared Chocolatier dark and Kimbie Light palettes without editing tracked configuration."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import time
import tomllib
import plistlib
import shutil

ROOT = Path(__file__).resolve().parents[2]
STATE = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state')) / 'dotfiles/theme'
CONFIG = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'dotfiles/theme/palette.json'


def palettes():
    values = json.loads((CONFIG if CONFIG.exists() else ROOT / 'themes/chocolatier.json').read_text())
    if not isinstance(values, dict) or set(values) != {'dark', 'light'}:
        raise ValueError('Shared palette requires dark and light modes')
    for p in values.values():
        if not isinstance(p, dict):
            raise ValueError('Invalid shared palette')
        for key in ('bg', 'surface', 'selection', 'muted', 'fg', 'bright', 'red', 'green', 'yellow', 'blue', 'purple', 'cyan', 'ansi', 'picker'):
            if key not in p:
                raise ValueError('Missing palette color: ' + key)
        if not isinstance(p['ansi'], list) or not isinstance(p['picker'], dict):
            raise ValueError('Invalid shared palette')
        if not {'hidden', 'muted', 'blue', 'green', 'yellow', 'red', 'purple', 'cyan'} <= p['picker'].keys():
            raise ValueError('Missing picker color')
        if any(not isinstance(p[key], str) for key in ('bg', 'surface', 'selection', 'muted', 'fg', 'bright', 'red', 'green', 'yellow', 'blue', 'purple', 'cyan')):
            raise ValueError('Invalid palette color')
        colors = [v for v in p.values() if isinstance(v, str)] + p['ansi'] + list(p['picker'].values())
        if len(p['ansi']) != 16 or not all(isinstance(c, str) and re.fullmatch(r'#[0-9a-fA-F]{6}', c) for c in colors):
            raise ValueError('Invalid shared palette')
    return values


def schemes(values):
    names = ['black', 'red', 'green', 'yellow', 'blue', 'purple', 'cyan', 'white',
             'brightBlack', 'brightRed', 'brightGreen', 'brightYellow', 'brightBlue', 'brightPurple', 'brightCyan', 'brightWhite']
    return [dict(zip(names, p['ansi']), name='Chocolatier' if mode == 'dark' else 'Kimbie Light',
                 background=p['bg'], foreground=p['fg'], cursorColor=p['bright'], selectionBackground=p['selection'])
            for mode, p in values.items()]


def atomic(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def tmux_style(p):
    return '\n'.join([
        f'set -g status-style "bg=default,fg={p["fg"]}"',
        f'set -g status-left "#[fg={p["cyan"]},bold]󰞌 #S #[fg={p["muted"]}]│ "',
        f'set -g @dotfiles-status-right "#[fg={p["purple"]}]󰌢 #h #[fg={p["muted"]}]│ #[fg={p["cyan"]}]󰥔 %H:%M "',
        f'setw -g window-status-format "#[fg={p["muted"]}]#I:#W"',
        f'setw -g window-status-current-format "#[fg={p["cyan"]},bold]◆ #I:#W"',
        f'set -g pane-border-style "fg={p["muted"]}"',
        f'set -g pane-active-border-style "fg={p["cyan"]}"',
        f'set -g message-style "bg=default,fg={p["cyan"]},bold"',
        f'set -g mode-style "bg={p["selection"]},fg={p["fg"]},bold"',
        f'set -g popup-style "bg=default,fg={p["fg"]}"',
        f'set -g popup-border-style "fg={p["cyan"]}"',
        f'set -g @runcat-color "{p["cyan"]}"', ''])


def windows(mode, values, check=False):
    if os.environ.get('DOTFILES_THEME_NO_WINDOWS') == '1':
        return 'disabled; skipped'
    if not os.environ.get('WSL_DISTRO_NAME') and 'microsoft' not in os.uname().release.lower():
        return 'not WSL; skipped'
    powershell = '/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe'
    if not Path(powershell).exists():
        raise RuntimeError('Windows PowerShell unavailable; Windows Terminal was not updated')
    def winpath(path):
        return subprocess.check_output(['wslpath', '-w', str(path)], text=True).strip()
    # Temporary payload also keeps verbose status from changing saved state.
    with tempfile.TemporaryDirectory(prefix='dotfiles-theme-') as temporary:
        payload = Path(temporary) / 'schemes.json'
        payload.write_text(json.dumps(schemes(values)))
        result = subprocess.run([powershell, '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass',
                                 '-File', winpath(ROOT / 'windows-terminal/Apply-Theme.ps1'),
                                 '-Mode', mode, '-SchemesPath', winpath(payload)] + (['-CheckOnly'] if check else []), capture_output=True, text=True)
        if result.returncode:
            raise RuntimeError(result.stderr.strip() or 'Windows Terminal update failed')
    # Backup paths remain in Windows Terminal's native settings directory.
    return result.stdout.strip() or 'settings validated; live appearance unverified'


def mix(color, base, amount):
    """Blend `amount` of `color` into `base` for tinted backgrounds."""
    a, b = (int(color[i:i + 2], 16) for i in (1, 3, 5)), (int(base[i:i + 2], 16) for i in (1, 3, 5))
    return '#' + ''.join(f'{round(x * amount + y * (1 - amount)):02X}' for x, y in zip(a, b))


def claude_theme(mode, p):
    """Generate Claude Code custom theme for native reload where supported."""
    tokens = {
        'text': p['fg'], 'inverseText': p['bg'], 'inactive': p['picker']['muted'], 'subtle': p['muted'],
        'promptBorder': p['muted'], 'promptBorderShimmer': p['selection'],
        'permission': p['blue'], 'suggestion': p['blue'], 'ide': p['blue'], 'remember': p['blue'],
        'planMode': p['cyan'], 'background': p['cyan'],
        'autoAccept': p['purple'], 'skill': p['purple'], 'merged': p['purple'], 'bashBorder': p['purple'],
        'success': p['green'], 'error': p['red'], 'warning': p['yellow'],
        'diffAdded': mix(p['green'], p['bg'], 0.3), 'diffRemoved': mix(p['red'], p['bg'], 0.3),
        'diffAddedDimmed': mix(p['green'], p['bg'], 0.15), 'diffRemovedDimmed': mix(p['red'], p['bg'], 0.15),
        'diffAddedWord': p['green'], 'diffRemovedWord': p['red'],
        'userMessageBackground': p['surface'], 'userMessageBackgroundHover': p['selection'],
        'bashMessageBackgroundColor': p['surface'], 'memoryBackgroundColor': p['surface'],
        'selectionBg': p['selection'], 'clawd_background': p['bg'],
    }
    return {'name': 'Dotfiles', 'base': mode, 'overrides': tokens}


def set_toml_key(text, section, key, value):
    """Set `key = "value"` in a TOML [section] with a line edit, leaving everything else untouched."""
    lines, line = text.splitlines(), f'{key} = "{value}"'
    try:
        start = lines.index(f'[{section}]')
    except ValueError:
        return text.rstrip('\n') + ('\n\n' if text.strip() else '') + f'[{section}]\n{line}\n'
    end = next((i for i in range(start + 1, len(lines)) if lines[i].lstrip().startswith('[')), len(lines))
    for i in range(start + 1, end):
        if re.match(rf'\s*{re.escape(key)}\s*=', lines[i]):
            lines[i] = line
            break
    else:
        lines.insert(start + 1, line)
    return '\n'.join(lines) + '\n'


def remove_toml_key(text, section, key):
    """Delete `key` from a TOML [section] with a line edit, leaving everything else untouched."""
    lines = text.splitlines()
    if f'[{section}]' not in lines:
        return text
    start = lines.index(f'[{section}]')
    end = next((i for i in range(start + 1, len(lines)) if lines[i].lstrip().startswith('[')), len(lines))
    kept = [l for i, l in enumerate(lines) if not (start < i < end and re.match(rf'\s*{re.escape(key)}\s*=', l))]
    return '\n'.join(kept) + '\n' if kept != lines else text


def codex_config(text, mode):
    updated = set_toml_key(text, 'tui', 'theme', 'dotfiles-kimbie-light') if mode == 'light' else remove_toml_key(text, 'tui', 'theme')
    tomllib.loads(updated)
    return updated


def apps(mode, p):
    """Point Claude Code and Codex at the active palette when they are installed."""
    if os.environ.get('DOTFILES_THEME_NO_APPS') == '1':
        return False
    claude = Path(os.environ.get('CLAUDE_CONFIG_DIR', Path.home() / '.claude'))
    if claude.is_dir():
        settings_path = claude / 'settings.json'
        settings = json.loads(settings_path.read_text()) if settings_path.exists() else {}
        needs_reopen = not (claude / 'themes').is_dir() or settings.get('theme') != 'custom:dotfiles'
        settings['theme'] = 'custom:dotfiles'
        atomic(settings_path.resolve(), json.dumps(settings, indent=2) + '\n')
        atomic(claude / 'themes/dotfiles.json', json.dumps(claude_theme(mode, p), indent=2) + '\n')
        if needs_reopen:
            print('Warning: Claude Code custom theme enabled; existing sessions may need reopening.', file=sys.stderr)
    codex = Path(os.environ.get('CODEX_HOME', Path.home() / '.codex'))
    if codex.is_dir():
        config = codex / 'config.toml'
        text = config.read_text() if config.exists() else ''
        # Light uses generated Kimbie syntax colours; dark keeps Codex's own default theme.
        updated = codex_config(text, mode)
        if mode == 'light':
            atomic(codex / 'themes/dotfiles-kimbie-light.tmTheme', codex_theme(p))
        if updated != text:
            atomic(config.resolve(), updated)
        return True
    return False


def refresh_tmux_colours(terminals):
    """Ask outer terminals for fresh defaults; tmux owns reading their replies."""
    pending = dict(terminals)
    started = time.monotonic()
    # Windows Terminal reloads settings asynchronously. Repeat bounded queries
    # without consuming input or mistaking a successful write for a verified reply.
    for offset in (0, 0.25, 1, 2):
        if not pending:
            break
        delay = started + offset - time.monotonic()
        if delay > 0:
            time.sleep(delay)
        for terminal in sorted(pending):
            try:
                fd = os.open(terminal, os.O_WRONLY | os.O_NOCTTY | os.O_NONBLOCK)
                try:
                    if not os.isatty(fd):
                        raise OSError('client terminal is no longer a TTY')
                    # A detached client's TTY may now belong to its parent shell.
                    # Query process metadata: tcgetpgrp rejects other sessions' TTYs.
                    owner = subprocess.run(['ps', '-p', str(pending[terminal]), '-o', 'pgid=,tpgid='],
                                           capture_output=True, text=True, timeout=1)
                    groups = owner.stdout.split()
                    if (owner.returncode or len(groups) != 2 or not groups[0].isdecimal()
                            or int(groups[0]) <= 0 or groups[0] != groups[1]):
                        raise OSError('tmux client no longer owns terminal')
                    # Background first: tmux derives light/dark reports from it.
                    query = b'\x1b]11;?\x1b\\\x1b]10;?\x1b\\'
                    if os.write(fd, query) != len(query):
                        raise OSError('incomplete terminal colour query')
                finally:
                    os.close(fd)
            except (OSError, subprocess.SubprocessError) as error:
                del pending[terminal]
                print(f'Warning: tmux colour refresh failed for {terminal}: {error}; '
                      'detach/reattach tmux before reopening Codex.', file=sys.stderr)


def reload_tmux():
    sockets = [None]
    terminals = {}
    if os.environ.get('TMUX'):
        sockets.insert(0, os.environ['TMUX'].split(',')[0])
    for socket in sockets:
        command = ['tmux'] + (['-S', socket] if socket else [])
        try:
            if subprocess.run(command + ['has-session'], capture_output=True).returncode == 0:
                result = subprocess.run(command + ['source-file', str(STATE / 'tmux.conf')], capture_output=True, text=True)
                if result.returncode:
                    raise RuntimeError('tmux theme reload failed after apply: ' + result.stderr.strip())
                try:
                    clients = subprocess.run(command + ['list-clients', '-F', '#{client_control_mode}\t#{client_pid}\t#{client_tty}'],
                                             capture_output=True, text=True, timeout=2)
                    if clients.returncode:
                        raise RuntimeError(clients.stderr.strip() or 'client listing failed')
                    for line in clients.stdout.splitlines():
                        fields = line.split('\t', 2)
                        if len(fields) == 3:
                            control, pid, terminal = fields
                            if control == '0' and terminal and pid.isdecimal() and int(pid) > 0:
                                terminals[terminal] = int(pid)
                except (OSError, RuntimeError, subprocess.SubprocessError) as error:
                    print(f'Warning: tmux colour refresh unavailable: {error}; '
                          'detach/reattach tmux before reopening Codex.', file=sys.stderr)
        except FileNotFoundError:
            break
    refresh_tmux_colours(terminals)


def codex_theme(p):
    """TextMate theme adapted from Jan T. Sott's Kimbie Light (CC BY-SA 4.0)."""
    settings = [{'settings': {'background': p['bg'], 'foreground': p['fg'],
                             'selection': p['selection'], 'caret': p['fg']}}]
    for scope, color in [('comment', 'muted'), ('string', 'green'), ('constant.numeric', 'yellow'),
                         ('keyword, storage', 'purple'), ('entity.name.function, support.function', 'blue'),
                         ('variable, entity.name.tag', 'red'), ('constant.language', 'cyan')]:
        settings.append({'scope': scope, 'settings': {'foreground': p[color]}})
    return plistlib.dumps({'name': 'Dotfiles Kimbie Light', 'settings': settings}).decode()


def writable(path):
    path = path.resolve()
    parent = path.parent
    while not parent.exists():
        parent = parent.parent
    if not parent.is_dir() or not os.access(parent, os.W_OK | os.X_OK):
        raise ValueError(f'Cannot write {path}')
    if path.exists() and (not path.is_file() or not os.access(path, os.W_OK)):
        raise ValueError(f'Cannot write {path}')


def preflight(mode, values):
    """Validate every local destination before applying any application config."""
    for path in (STATE / 'mode', STATE / 'tmux.conf'):
        writable(path)
    if os.environ.get('DOTFILES_THEME_NO_APPS') != '1':
        claude = Path(os.environ.get('CLAUDE_CONFIG_DIR', Path.home() / '.claude'))
        codex = Path(os.environ.get('CODEX_HOME', Path.home() / '.codex'))
        if claude.is_dir():
            settings = claude / 'settings.json'
            data = json.loads(settings.read_text()) if settings.exists() else {}
            if not isinstance(data, dict):
                raise ValueError('Claude settings must be a JSON object')
            for path in (settings, claude / 'themes/dotfiles.json'):
                writable(path)
        if codex.is_dir():
            config = codex / 'config.toml'
            text = config.read_text() if config.exists() else ''
            tomllib.loads(text)
            codex_config(text, mode)
            for path in (config, codex / 'themes/dotfiles-kimbie-light.tmTheme'):
                writable(path)
    plistlib.loads(codex_theme(values[mode]).encode())
    json.dumps(claude_theme(mode, values[mode]))
    # Windows validates its JSONC and destination before other apps are changed.
    return windows(mode, values, check=True)


def status(mode, verbose):
    print(mode)
    if not verbose:
        return
    try:
        values = palettes()
        windows_status = preflight(mode, values)
        print('Windows Terminal: ' + windows_status)
        print('Integration preflight: ready (configuration checks only)')
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print('Integration preflight: ' + str(error))
    print('Neovim: ' + ('saved mode watched; live appearance unverified' if shutil.which('nvim') else 'not installed; skipped'))
    print('tmux: ' + ('terminal colour queries retried on apply for up to 2 seconds; '
                     'cache and live appearance unverified' if shutil.which('tmux') else 'not installed; skipped'))
    if os.environ.get('DOTFILES_THEME_NO_APPS') == '1':
        print('Agent apps: disabled; skipped')
    else:
        claude = Path(os.environ.get('CLAUDE_CONFIG_DIR', Path.home() / '.claude'))
        codex = Path(os.environ.get('CODEX_HOME', Path.home() / '.codex'))
        print('Claude Code: ' + ('custom theme managed on apply; live appearance unverified' if claude.is_dir() else 'config directory absent; skipped'))
        print('Codex: ' + ('syntax theme managed on apply; exit and run codex resume to refresh; '
                          'if still stale, detach/reattach tmux first' if codex.is_dir() else 'config directory absent; skipped'))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', nargs='?', default='status', choices=['light', 'dark', 'toggle', 'status', 'apply'])
    parser.add_argument('--verbose', action='store_true', help='show configuration health and live-refresh limits')
    args = parser.parse_args()
    if args.verbose and args.action != 'status':
        parser.error('--verbose is only supported with status')
    if args.action == 'status':
        mode = (STATE / 'mode').read_text().strip() if (STATE / 'mode').exists() else 'dark'
        if mode not in ('dark', 'light'):
            raise ValueError('Invalid saved theme mode')
        status(mode, args.verbose)
        return
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / 'lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        mode = (STATE / 'mode').read_text().strip() if (STATE / 'mode').exists() else 'dark'
        if mode not in ('dark', 'light'):
            raise ValueError('Invalid saved theme mode')
        if args.action == 'toggle':
            mode = 'light' if mode == 'dark' else 'dark'
        elif args.action in ('dark', 'light'):
            mode = args.action
        values = palettes()
        preflight(mode, values)
        windows(mode, values)
        codex_updated = apps(mode, values[mode])
        atomic(STATE / 'tmux.conf', tmux_style(values[mode]))
        atomic(STATE / 'mode', mode + '\n')
        reload_tmux()
        if codex_updated:
            print('Warning: Codex: exit and run codex resume to refresh interface and syntax colours; '
                  'if still stale, detach/reattach tmux first.', file=sys.stderr)
        print(mode)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print('dotfiles-theme: ' + str(error), file=sys.stderr)
        sys.exit(1)
